<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_questions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient">

            <View
                android:id="@+id/blobQuestions"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-70dp"
                android:background="@drawable/bg_blob" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="52dp"
                android:paddingBottom="56dp">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CareerMitra"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.12"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emotional Assessment"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.01"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Answer honestly to get better career guidance"
                    android:textSize="15sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- CARD (overlaps header) -->
        <LinearLayout
            android:id="@+id/cardQuestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:padding="20dp"
            android:elevation="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-32dp">

            <!-- QUESTION 1 -->
            <LinearLayout
                android:id="@+id/q1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="1. How motivated do you feel today?"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>

                    <TextView
                        android:id="@+id/tvValue1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_value_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="0/10"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="10"
                    android:progressTint="#4F46E5"
                    android:progressBackgroundTint="#E0E0EA"
                    android:thumbTint="#F59E0B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:textSize="12sp" android:textColor="#8E8E93"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High" android:textSize="12sp" android:textColor="#8E8E93"/>
                </LinearLayout>
            </LinearLayout>

            <!-- QUESTION 2 -->
            <LinearLayout
                android:id="@+id/q2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="2. How confident are you in your skills?"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>

                    <TextView
                        android:id="@+id/tvValue2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_value_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="0/10"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="10"
                    android:progressTint="#4F46E5"
                    android:progressBackgroundTint="#E0E0EA"
                    android:thumbTint="#F59E0B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:textSize="12sp" android:textColor="#8E8E93"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High" android:textSize="12sp" android:textColor="#8E8E93"/>
                </LinearLayout>
            </LinearLayout>

            <!-- QUESTION 3 -->
            <LinearLayout
                android:id="@+id/q3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="3. How well do you handle stress?"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>

                    <TextView
                        android:id="@+id/tvValue3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_value_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="0/10"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="10"
                    android:progressTint="#4F46E5"
                    android:progressBackgroundTint="#E0E0EA"
                    android:thumbTint="#F59E0B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:textSize="12sp" android:textColor="#8E8E93"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High" android:textSize="12sp" android:textColor="#8E8E93"/>
                </LinearLayout>
            </LinearLayout>

            <!-- QUESTION 4 -->
            <LinearLayout
                android:id="@+id/q4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="4. How focused are you on your career goals?"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>

                    <TextView
                        android:id="@+id/tvValue4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_value_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="0/10"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="10"
                    android:progressTint="#4F46E5"
                    android:progressBackgroundTint="#E0E0EA"
                    android:thumbTint="#F59E0B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:textSize="12sp" android:textColor="#8E8E93"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High" android:textSize="12sp" android:textColor="#8E8E93"/>
                </LinearLayout>
            </LinearLayout>

            <!-- QUESTION 5 -->
            <LinearLayout
                android:id="@+id/q5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="5. How satisfied are you with your progress?"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1C1C1E"/>

                    <TextView
                        android:id="@+id/tvValue5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_value_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="0/10"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="10"
                    android:progressTint="#4F46E5"
                    android:progressBackgroundTint="#E0E0EA"
                    android:thumbTint="#F59E0B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:textSize="12sp" android:textColor="#8E8E93"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High" android:textSize="12sp" android:textColor="#8E8E93"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGetRecommendations"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="Get Career Recommendations  ✨"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:elevation="6dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#4F46E5"/>

    </LinearLayout>
</ScrollView>