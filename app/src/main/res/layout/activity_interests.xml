<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <!-- TITLE -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="30dp"
        android:letterSpacing="0.02"
        android:text="CarrerMitra \nYour Interests"
        android:textColor="#000000"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tell us what excites you"
        android:textSize="14sp"
        android:textColor="#6E6E73"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- INPUT CARD -->
    <LinearLayout
        android:id="@+id/cardInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_apple_card"
        android:elevation="6dp"
        android:padding="20dp"
        android:layout_margin="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editTextInterest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Add an interest (e.g. Design, AI)"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="@drawable/bg_apple_input"
            android:textColor="#000000"
            android:textColorHint="#8E8E93"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddInterest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            app:cornerRadius="14dp"
            android:backgroundTint="#007AFF"/>
    </LinearLayout>

    <!-- INTEREST LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewInterests"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardInput"
        app:layout_constraintBottom_toTopOf="@id/buttonNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- NEXT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonNext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_margin="24dp"
        android:paddingVertical="14dp"
        app:cornerRadius="16dp"
        android:backgroundTint="#007AFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
