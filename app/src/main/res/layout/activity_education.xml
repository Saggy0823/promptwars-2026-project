<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <FrameLayout
            android:id="@+id/fl_edu_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient">

            <View
                android:id="@+id/blob_edu"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-70dp"
                android:background="@drawable/bg_blob" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="56dp"
                android:paddingBottom="68dp">

                <TextView
                    android:id="@+id/tv_edu_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CareerMitra"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.12"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tv_edu_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Education Profile"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tv_edu_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tell us about your academic journey"
                    android:textSize="15sp"
                    android:textColor="#CCFFFFFF"/>
            </LinearLayout>
        </FrameLayout>

        <!-- CARD (overlaps header) -->
        <LinearLayout
            android:id="@+id/card_education"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:padding="20dp"
            android:elevation="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-40dp"
            android:layout_marginBottom="24dp">

            <!-- NAME -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/box_stroke"
                app:hintTextColor="#4F46E5"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="#6D28D9">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#1C1C1E"
                    android:padding="12dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- EDUCATION TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Education Level"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#1C1C1E"
                android:layout_marginTop="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select all that apply"
                android:textSize="13sp"
                android:textColor="#8E8E93"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <!-- CHIP GROUP -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEducation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="10dp"
                app:chipSpacingVertical="10dp"/>

            <!-- DYNAMIC FIELDS -->
            <LinearLayout
                android:id="@+id/layoutSpecializationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- NEXT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNext"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="32dp"
            android:text="Continue  →"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:elevation="6dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#4F46E5"/>
    </LinearLayout>
</ScrollView>