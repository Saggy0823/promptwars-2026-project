<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient">

            <View
                android:id="@+id/blobUserData"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-70dp"
                android:background="@drawable/bg_blob" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="48dp"
                android:paddingBottom="52dp">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CareerMitra"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.12"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Know Your Knowledge Gap"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.01"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tell us what to test and we'll build your quiz"
                    android:textSize="15sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- FORM CARD -->
        <LinearLayout
            android:id="@+id/cardUserData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_elevated"
            android:elevation="8dp"
            android:padding="18dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-28dp">

            <EditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Your name"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="40"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textColorHint="#9A9AA5"
                android:padding="14dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editTextEducation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="What are you studying? (e.g. B.Sc Computer Science, 2nd year)"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:imeOptions="actionNext"
                android:textColor="#1C1C1E"
                android:textColorHint="#9A9AA5"
                android:padding="14dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editTextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="Field / stream (e.g. Computer Science, Commerce)"
                android:inputType="textCapWords"
                android:maxLength="80"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textColorHint="#9A9AA5"
                android:padding="14dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editTextDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="Domain to test (e.g. Data Structures, Accounting)"
                android:inputType="textCapWords"
                android:maxLength="80"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textColorHint="#9A9AA5"
                android:padding="14dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/editTextTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="Specific topics (optional, comma separated)"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="200"
                android:maxLines="3"
                android:imeOptions="actionDone"
                android:textColor="#1C1C1E"
                android:textColorHint="#9A9AA5"
                android:padding="14dp"
                android:textSize="16sp" />

            <!-- LEVEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Your current level"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"/>

            <LinearLayout
                android:id="@+id/rowLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipBeginner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beginner"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    android:background="@drawable/bg_option_chip"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipIntermediate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intermediate"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    android:background="@drawable/bg_option_chip"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipAdvanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Advanced"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    android:background="@drawable/bg_option_chip"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- NUMBER OF QUESTIONS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Number of questions"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"/>

            <LinearLayout
                android:id="@+id/rowCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipQ5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    android:background="@drawable/bg_option_chip"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipQ10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    android:background="@drawable/bg_option_chip"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipQ15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textSize="14sp"
                    android:textColor="@color/chip_text_selector"
                    android:background="@drawable/bg_option_chip"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGenerateQuiz"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="24dp"
            android:text="Generate My Quiz  🧠"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:elevation="6dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#4F46E5"/>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="Takes about a minute. Please keep the app open."
            android:textSize="13sp"
            android:textColor="#8E8E93"/>
    </LinearLayout>
</ScrollView>