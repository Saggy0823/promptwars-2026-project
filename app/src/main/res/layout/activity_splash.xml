<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_welcome_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Decorative blobs -->
    <View
        android:id="@+id/splash_blob_top"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-90dp"
        android:background="@drawable/bg_blob" />

    <View
        android:id="@+id/splash_blob_bottom"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-120dp"
        android:background="@drawable/bg_blob" />

    <!-- Logo with glow ring -->
    <FrameLayout
        android:id="@+id/splash_logo_wrap"
        android:layout_centerInParent="true"
        android:layout_width="240dp"
        android:layout_height="240dp">

        <View
            android:id="@+id/splash_pulse_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pulse_ring" />

        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/splash_logo"
                android:src="@drawable/logo"
                android:layout_gravity="center"
                android:layout_width="150dp"
                android:layout_height="150dp"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Name + tagline -->
    <LinearLayout
        android:id="@+id/splash_text_wrap"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_below="@id/splash_logo_wrap"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/splash_title"
            android:text="CareerMitra"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/splash_tagline"
            android:text="Find your path"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:letterSpacing="0.1"
            android:layout_marginTop="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Loading bar -->
    <FrameLayout
        android:id="@+id/splash_progress_wrap"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="64dp"
        android:layout_width="160dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_progress_track">

        <View
            android:id="@+id/splash_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_fill" />
    </FrameLayout>
</RelativeLayout>